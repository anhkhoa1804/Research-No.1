diff --git a/maskrcnn_benchmark/csrc/compat/thc_shim.h b/maskrcnn_benchmark/csrc/compat/thc_shim.h
new file mode 100644
index 0000000..cd99545
--- /dev/null
+++ b/maskrcnn_benchmark/csrc/compat/thc_shim.h
@@ -0,0 +1,12 @@
+// Minimal torch2-compatibility shim for the handful of THC/* symbols this
+// codebase's CUDA extensions use. THC/THC.h and friends were removed from
+// libtorch; this replaces exactly the symbols actually called here
+// (THCCeilDiv, THCudaCheck) with their modern ATen/c10 equivalents. Not a
+// general-purpose THC replacement -- scoped to this port only.
+#pragma once
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAException.h>
+
+#define THCudaCheck(EXPR) C10_CUDA_CHECK(EXPR)
+
+__host__ __device__ inline long THCCeilDiv(long a, long b) { return (a + b - 1) / b; }
