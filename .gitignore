# Training / evaluation outputs
# Root-anchored (leading /) so these only match the top-level data/output
# directories they're meant for -- an earlier, unanchored `datasets/` here
# also matched openvocab_rel/datasets/ (the tracked Python subpackage),
# which `git add` warns about (though it doesn't actually block adding an
# already-tracked file, this was still a real latent footgun for anyone
# adding a *new* file under that subpackage in the future).
/runs/
/checkpoints/
/suite_reports/
/synthetic_out/
/datasets/
/datasets_old/
/datasets_vg150_clean/
/third_party_models/
/data_prep/
*.log
*.tmp
*.bak
*.old
*.orig
*.dump
*.pt
*.pth
*.ckpt
*.h5
*.parquet
*.zip
*.pdf

# OS and editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Ad-hoc analysis scratch output left in the repo root by an assistant/audit
# session (e.g. field_list.txt from a one-off grep dump). If you generate a
# throwaway file like this while investigating something, put it under an
# ignored scratch/ directory or delete it before committing -- don't add a
# broad root-level glob here, since that would also hide real top-level
# config/docs files.
scratch/

